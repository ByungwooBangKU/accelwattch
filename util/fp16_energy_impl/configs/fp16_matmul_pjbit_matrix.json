{
  "description": "FP16 Tensor Core matmul logical pJ/bit matrix. Uses structural Tensor baselines and suppresses output stores so timed kernels do not intentionally touch L2/global memory. The pJ/bit denominator is logical MMA operand bits, not DRAM traffic bits.",
  "defaults": {
    "blocks": 0,
    "blocks_per_sm": 8,
    "threads": 256,
    "warmup": 2,
    "repeats": 1,
    "unroll": 8,
    "suppress_output_store": true
  },
  "conditions": [
    {
      "name": "matmul_tensor_mma_f16acc_vs_tensor_baseline",
      "baseline": {
        "kernel": "tensor_baseline_u32",
        "iters": 1000000,
        "repeats": 3
      },
      "test": {
        "kernel": "tensor_mma_f16acc",
        "iters": 1000000
      }
    },
    {
      "name": "matmul_tensor_mma_f32acc_vs_tensor_baseline",
      "baseline": {
        "kernel": "tensor_baseline_f32",
        "iters": 1000000,
        "repeats": 10
      },
      "test": {
        "kernel": "tensor_mma_f32acc",
        "iters": 1000000
      }
    }
  ]
}
